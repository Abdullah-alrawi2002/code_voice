OPENAI_API_KEY=your-openai-api-key-here
# Required only for real inbound phone calls through OpenAI Realtime SIP.
OPENAI_WEBHOOK_SECRET=whsec_your-webhook-secret

# Current Realtime defaults; change only after checking model availability.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_VOICE=marin

# Relative paths are resolved from backend/.
DATABASE_PATH=data/televic_support.db
ALLOWED_ORIGINS=http://localhost:3000
